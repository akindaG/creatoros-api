APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/creatoros
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# AI provider: gemini (recommended for hosted production) or ollama (local Qwen)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
OLLAMA_TIMEOUT_SECONDS=45
AI_FALLBACK_ENABLED=true

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=creatoros-media
MEDIA_LOCAL_DIR=media
MAX_UPLOAD_MB=25

# Use live only after Meta OAuth is configured and tested.
SOCIAL_PUBLISH_MODE=simulate
META_GRAPH_BASE_URL=https://graph.facebook.com/v26.0
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/social-accounts/facebook/callback

# Instagram API with Instagram Login. Supports Instagram Business and Creator
# accounts directly, without requiring a linked Facebook Page.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/social-accounts/instagram/callback
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com/v26.0
INSTAGRAM_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights

# Optional dedicated secret. If omitted, CreatorOS derives the encryption key from JWT_SECRET_KEY.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Required only when using POST /api/v1/internal/process-due from an external cron service.
CRON_SECRET=
PUBLISH_BATCH_SIZE=100
